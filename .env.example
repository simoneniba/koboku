# Web3Forms access key — create for free at https://web3forms.com
# (tie it to the studio inbox, e.g. studio.koboku@gmail.com).
# Set the same variable in Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# ── Education purchase → access loop ──────────────────────────────────────
# Set ALL of these in Vercel → Project → Settings → Environment Variables
# (Production + Preview as needed). Never commit real secrets.

# Site
SITE_URL=https://koboku.it

# Gumroad Ping webhook (enabled path — no Stripe in this repo)
GUMROAD_SELLER_ID=
GUMROAD_PRODUCT_IDS=
WEBHOOK_SECRET=

# Supabase — public (browser + SSR cookie client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server only (webhook, admin magic links). Never NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (access emails)
RESEND_API_KEY=
FROM_EMAIL=access@koboku.it

# Stripe — NOT enabled. Leave unset. See comments in src/app/api/purchase/route.ts
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
